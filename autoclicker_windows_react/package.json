{
  "name": "autoclicker-windows-react",
  "version": "0.1.2",
  "description": "AutoClicker Windows - automatyzacja pracy w wielu kartach przeglądarki",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "node-machine-id": "^1.1.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.company.web-test-automation-react",
    "productName": "AutoClicker Windows",
    "publish": [
      {
        "provider": "github",
        "owner": "bawar007",
        "repo": "AutoClicker_PC",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../src/license",
        "to": "license"
      },
      {
        "from": "../src/auto-clicker.js",
        "to": "auto-clicker.js"
      },
      {
        "from": "node_modules/node-machine-id",
        "to": "node_modules/node-machine-id"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    }
  }
}
